# Set these as Supabase Edge Function secrets:
#   supabase secrets set --env-file .env
# NEVER commit the real .env file.

# Meta / WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string
WHATSAPP_API_VERSION=v23.0
# Approved Utility template with ONE variable, body like: "Sherr I update: {{1}}"
WHATSAPP_TEMPLATE_NAME=sherr_update
WHATSAPP_TEMPLATE_LANG=en

# Gemini (free tier is fine for testing; use a paid key before real users)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Same value you store in Vault as sherr_cron_secret (supabase/sql/cron.sql)
CRON_SECRET=pick-another-long-random-string

# Optional: only these numbers can use Sherr I (comma separated). Empty = everyone.
ALLOWED_NUMBERS=
# Shown to users, e.g. +1 555 123 4567 (your test number)
SHERR_DISPLAY_NUMBER=
